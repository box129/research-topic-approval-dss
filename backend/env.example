# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
API_VERSION=v1
# Graceful shutdown drain window. Production enforces 180000-300000 ms;
# default 300000 ms protects the demonstrated long-running bulk onboarding flow.
SHUTDOWN_GRACE_PERIOD_MS=300000

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/topic_similarity?schema=public"

# Shadow database URL for Prisma migrations (optional for managed databases)
# If using a managed database service (like Neon, Supabase), you may need this
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/topic_similarity_shadow?schema=public"

# ============================================
# Semantic Provider Configuration
# ============================================
# Voyage is the semantic provider used by the current similarity flow. Keep
# this value only in the deployment secret store; never commit it or expose it
# to the browser. Production startup rejects a missing value because Voyage is
# a core DSS capability; non-production readiness remains degraded without it.
VOYAGE_API_KEY=

# Bound each Voyage embedding request. A timeout is reported as a semantic
# provider failure; it does not silently retry through a fallback provider.
# Allowed range: 1000-60000 milliseconds. Default: 10000.
VOYAGE_REQUEST_TIMEOUT_MS=10000

# Cache one low-cost Voyage readiness probe per backend process for this long.
# Allowed range: 10000-3600000 milliseconds. Default: 300000 (5 minutes).
VOYAGE_READINESS_PROBE_CACHE_MS=300000

# ============================================
# Proxy and Rate Limiting Configuration
# ============================================
# Do not trust forwarding headers unless the deployment topology is known.
# Safe values are false (default), 0-10 trusted proxy hops, loopback,
# linklocal, uniquelocal, or a comma-separated list of exact IP/CIDR ranges.
# Never set TRUST_PROXY=true or TRUST_PROXY=*; both are rejected at startup.
TRUST_PROXY=false
# Example for exactly one trusted reverse proxy: TRUST_PROXY=1
# Example for known proxy ranges: TRUST_PROXY=loopback,10.0.0.0/8

# Broad, low-cost limiter. Valid cookie sessions are keyed by authenticated
# user ID; unauthenticated traffic is keyed by client IP. The high default
# avoids collapsing a shared departmental NAT into one ordinary-user quota.
# Limits use the process-local Express memory store; use a shared rate-limit
# store or gateway policy before relying on them across multiple backend nodes.
# Window default: 900000 milliseconds (15 minutes).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# IPv6 client keys are grouped by a subnet rather than a full host address so
# a caller cannot rotate IPv6 host bits to evade an IP-keyed quota. Default:
# /56; allowed range: /32-/64. Choose a prefix appropriate for the network
# allocation when a deployment topology is known.
RATE_LIMIT_IPV6_SUBNET_PREFIX=56

# Dedicated auth/recovery window (default: 15 minutes) and endpoint limits.
# Login uses both IP and a privacy-preserving IP + hashed email identifier key.
# Forgot-password, invitation validation/acceptance, and reset flows are
# IP-keyed. Admin actions are keyed by the authenticated administrator.
AUTH_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=30
LOGIN_IDENTIFIER_RATE_LIMIT_MAX=8
FORGOT_PASSWORD_RATE_LIMIT_MAX=15
INVITATION_VALIDATION_RATE_LIMIT_MAX=30
INVITATION_ACCEPTANCE_RATE_LIMIT_MAX=10
RESET_PASSWORD_RATE_LIMIT_MAX=10
ADMIN_ACCOUNT_ACTION_RATE_LIMIT_MAX=30
ADMIN_BULK_INVITATION_RATE_LIMIT_MAX=10

# Bulk account-import bcrypt worker pool. Leave unset to use the CPU-derived
# bounded default; valid explicit values are 1-8. Set only after measuring the
# target host because it affects the long-running bulk operation.
# BULK_HASH_CONCURRENCY=2

# Import commit generates paid Voyage document embeddings for accepted rows;
# preview does not and is not governed by this dedicated limiter.
ADMIN_TOPIC_IMPORT_RATE_LIMIT_MAX=5

# Expensive semantic checks use a separate window and a user-keyed quota for
# authenticated users (IP fallback only before authentication).
SIMILARITY_RATE_LIMIT_WINDOW_MS=900000
SIMILARITY_RATE_LIMIT_MAX=30

# ============================================
# Request Size Limits
# ============================================
# JSON and URL-encoded request-body limit. Allowed range: 1024-5242880 bytes.
JSON_BODY_LIMIT_BYTES=102400

# Multipart topic-import file limit. Allowed range: 1024-5242880 bytes. The
# standard Nginx envelope is 6 MiB so a valid 5 MiB file can include multipart
# boundaries and fields.
IMPORT_UPLOAD_LIMIT_BYTES=5242880

# Multipart imports also bound individual text fields, total non-file fields,
# and total parts so a file-size cap cannot be bypassed with large form data.
# The standard ingress contract permits 1-10 fields, 2-12 parts, and
# 1024-16384 bytes per field; IMPORT_UPLOAD_MAX_PARTS must be at least
# IMPORT_UPLOAD_MAX_FIELDS + 1 for the uploaded workbook itself.
IMPORT_UPLOAD_MAX_FIELDS=10
IMPORT_UPLOAD_MAX_PARTS=12
IMPORT_UPLOAD_FIELD_SIZE_BYTES=16384

# ============================================
# CORS Configuration
# ============================================
# The browser origin must be one bare http(s) origin (scheme, host, optional
# port), with no path, query, fragment, or credentials. Production requires
# FRONTEND_URL as one explicit https:// origin. Wildcard (*) is rejected in
# every mode. This same origin is used for invitation and password-reset links.
FRONTEND_URL=http://localhost:5173

# Optional compatibility value, not a comma-separated allowlist. Leave it
# unset for the same-origin production topology; if supplied in production it
# must exactly equal FRONTEND_URL. It remains a local/non-production fallback.
CORS_ORIGIN=http://localhost:5173

# Allow credentialed CORS requests (literal true/false only). Keep true for
# the cookie-session browser contract.
CORS_CREDENTIALS=true

# ============================================
# Logging Configuration
# ============================================
# Logging level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# `LOG_FILE` is a legacy ignored setting. The active logger writes Console plus
# fixed local `logs/error.log` and `logs/combined.log`; use stdout/stderr as the
# operational sink and do not rely on those container-local files.

# ============================================
# Audit Log Governance
# ============================================
# Default retention policy for audit logs. This is project policy, not
# official institutional retention guidance unless separately approved.
AUDIT_LOG_RETENTION_DAYS=365

# Purge requests must target logs at least this old. Production rejects zero.
AUDIT_LOG_PURGE_MIN_AGE_DAYS=90

# Maximum audit rows deleted by one purge request.
AUDIT_LOG_PURGE_MAX_BATCH=1000

# ============================================
# Similarity Configuration
# ============================================
# Threshold for Tier 2 similarity (0.0 to 1.0)
# Topics with similarity >= this value are considered Tier 2
SIMILARITY_TIER2_THRESHOLD=0.60

# Time window for Tier 3 similarity check (in hours)
# Topics within this time window are checked for Tier 3 similarity
SIMILARITY_TIER3_TIME_WINDOW_HOURS=48

# ============================================
# Authentication
# ============================================
# Required in production. The development fallback is local-only and unsafe.
# Production rejects short values and known placeholders. Use a generated
# secret with at least 32 random characters and store it outside Git.
JWT_SECRET=replace_with_a_long_random_secret_before_production
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=rtadss_session
RESET_TOKEN_EXPIRES_MINUTES=30

# Session cookies are httpOnly, SameSite=Lax, and Secure in production.
# For state-changing requests that carry this session cookie, production
# requires an Origin or Referer that resolves to the configured browser origin;
# an absent or untrusted origin is rejected. Public invitation/reset flows use
# one-time tokens and do not depend on a session cookie.

# ============================================
# Email Delivery
# ============================================
# Supported values:
# - mock: local/test only; accepts email requests without external delivery
# - disabled: fail closed; useful when email delivery is intentionally unavailable
# - smtp: sends through the configured SMTP provider
# Production must set EMAIL_PROVIDER explicitly. EMAIL_PROVIDER=mock is rejected in production.
# EMAIL_PROVIDER=disabled is fail-closed. EMAIL_PROVIDER=smtp requires valid SMTP settings.
# Never commit real SMTP credentials to Git.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.edu

# Required only when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TIMEOUT_MS=10000

# Account-invitation link lifetime in hours (default 168 = 7 days, max 720).
# Invitation and password-reset links are built from FRONTEND_URL; with
# EMAIL_PROVIDER=smtp in production that URL must be https.
# INVITATION_EXPIRES_HOURS=168

# ============================================
# Optional: API Keys and Secrets
# ============================================
# Add any API keys or secrets here as needed
# API_KEY=your_api_key_here
