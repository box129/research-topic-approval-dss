# Copy this file to .env only for local Docker Compose verification.
# Never commit real .env files, secrets, SMTP passwords, database dumps, or raw departmental data.

POSTGRES_DB=topic_similarity
POSTGRES_USER=topic_similarity
POSTGRES_PASSWORD=replace_for_shared_or_staging_use
COMPOSE_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=8080
SBERT_PORT=8000

NODE_ENV=development
API_VERSION=v1
DATABASE_URL=postgresql://topic_similarity:replace_for_shared_or_staging_use@postgres:5432/topic_similarity?schema=public
JWT_SECRET=replace_with_a_long_random_secret_for_shared_or_staging_use
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
CORS_CREDENTIALS=true

# This value is injected into the backend at runtime and is never baked into an
# image. Leave it blank only for deliberately degraded local verification;
# semantic similarity and full readiness require a deployment-owned key.
VOYAGE_API_KEY=
VOYAGE_REQUEST_TIMEOUT_MS=10000
VOYAGE_READINESS_PROBE_CACHE_MS=300000

SBERT_SERVICE_URL=http://sbert-service:8000
SBERT_TIMEOUT=30000
SBERT_RETRY_ATTEMPTS=3
SBERT_LOG_LEVEL=INFO

# Local Compose defaults to disabled email. Use smtp only with deployment-owned secrets.
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@localhost
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TIMEOUT_MS=10000

AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_PURGE_MIN_AGE_DAYS=90
AUDIT_LOG_PURGE_MAX_BATCH=1000
LOG_LEVEL=info
