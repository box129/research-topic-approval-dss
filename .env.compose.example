# Copy this file to .env only for local Docker Compose verification.
# Never commit real .env files, secrets, SMTP passwords, database dumps, or raw departmental data.

POSTGRES_DB=topic_similarity
POSTGRES_USER=topic_similarity
POSTGRES_PASSWORD=replace_for_shared_or_staging_use
COMPOSE_BIND_HOST=127.0.0.1

FRONTEND_PORT=8080

NODE_ENV=development
API_VERSION=v1
DATABASE_URL=postgresql://topic_similarity:replace_for_shared_or_staging_use@postgres:5432/topic_similarity?schema=public
JWT_SECRET=replace_with_a_long_random_secret_for_shared_or_staging_use
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
CORS_CREDENTIALS=true
# Local Compose reaches the backend through exactly one frontend Nginx hop.
# A production TLS edge with a different proxy chain must set its verified
# TRUST_PROXY topology explicitly.
TRUST_PROXY=1

# This value is injected into the backend at runtime and is never baked into an
# image. Leave it blank only for deliberately degraded local verification;
# semantic similarity and full readiness require a deployment-owned key.
VOYAGE_API_KEY=
VOYAGE_REQUEST_TIMEOUT_MS=10000
VOYAGE_READINESS_PROBE_CACHE_MS=300000
SHUTDOWN_GRACE_PERIOD_MS=300000

# Local Compose defaults to disabled email. Use smtp only with deployment-owned secrets.
EMAIL_PROVIDER=disabled
EMAIL_FROM=no-reply@localhost
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=10000

INVITATION_EXPIRES_HOURS=168
RESET_TOKEN_EXPIRES_MINUTES=30

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
RATE_LIMIT_IPV6_SUBNET_PREFIX=56
AUTH_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=30
LOGIN_IDENTIFIER_RATE_LIMIT_MAX=8
FORGOT_PASSWORD_RATE_LIMIT_MAX=15
INVITATION_VALIDATION_RATE_LIMIT_MAX=30
INVITATION_ACCEPTANCE_RATE_LIMIT_MAX=10
RESET_PASSWORD_RATE_LIMIT_MAX=10
ADMIN_ACCOUNT_ACTION_RATE_LIMIT_MAX=30
ADMIN_BULK_INVITATION_RATE_LIMIT_MAX=10
ADMIN_TOPIC_IMPORT_RATE_LIMIT_MAX=5
# Leave unset to use the CPU-derived bounded worker-pool default. Set only
# after target-capacity testing; allowed integer range is 1-8.
BULK_HASH_CONCURRENCY=
SIMILARITY_RATE_LIMIT_WINDOW_MS=900000
SIMILARITY_RATE_LIMIT_MAX=30

JSON_BODY_LIMIT_BYTES=102400
IMPORT_UPLOAD_LIMIT_BYTES=5242880
IMPORT_UPLOAD_MAX_FIELDS=10
IMPORT_UPLOAD_MAX_PARTS=12
IMPORT_UPLOAD_FIELD_SIZE_BYTES=16384

AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_PURGE_MIN_AGE_DAYS=90
AUDIT_LOG_PURGE_MAX_BATCH=1000
LOG_LEVEL=info
