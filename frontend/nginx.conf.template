# Rendered at container start by the Nginx image's envsubst entrypoint into
# /etc/nginx/conf.d/default.conf. Only the variables named in
# NGINX_ENVSUBST_FILTER are substituted, so Nginx's own runtime variables
# ($host, $remote_addr, $request_uri, ...) survive untouched.
#
# Three values are provider-driven; every default is set in the Dockerfile so a
# plain `docker compose up` behaves exactly as before this template existed:
#
#   BACKEND_UPSTREAM         host:port of the private backend
#                            (Compose: backend:3000; a hosted platform supplies
#                            its own internal address — never hardcode a
#                            generated hostname here or in the image)
#   NGINX_LOCAL_RESOLVERS    detected from /etc/resolv.conf by the image's
#                            15-local-resolvers entrypoint script, so upstream
#                            re-resolution works on any platform's service DNS
#   PROXY_TIMEOUT            upstream/client timeout for long administrative
#                            operations

# The external HTTPS edge must sanitize X-Forwarded-Proto before it reaches
# this container. The container-to-container hop is intentionally HTTP, so
# preserve that trusted public HTTPS signal rather than overwriting it with
# this hop's $scheme value. Local direct requests fall back to $scheme.
map $http_x_forwarded_proto $public_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # Re-resolve the backend through the platform's own service DNS rather than
    # pinning the address resolved at startup: an Nginx tier with a static
    # upstream returns 502 after the backend container is replaced. The
    # resolver address is detected from the container's /etc/resolv.conf, so
    # this works for Docker's embedded DNS and for a hosted platform's internal
    # DNS without naming either.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ${BACKEND_RESOLVER_FLAGS};
    set $backend_upstream http://${BACKEND_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;
    # The backend enforces a 5 MiB file limit. Leave room for multipart
    # boundaries and form fields so an otherwise valid maximum-size workbook
    # reaches that authoritative check.
    client_max_body_size 6m;
    client_body_timeout ${PROXY_TIMEOUT};
    send_timeout ${PROXY_TIMEOUT};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;

    location /api/ {
        proxy_pass $backend_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        # Bulk departmental onboarding is a single synchronous request that has
        # been measured at roughly 324 seconds for 650 accounts, and the backend
        # sends no bytes at all until it finishes — so this "inactivity" timeout
        # is in practice a total deadline for that request. It must stay at or
        # above the 600-second hosted requirement established by runtime
        # acceptance, with margin.
        proxy_send_timeout ${PROXY_TIMEOUT};
        proxy_read_timeout ${PROXY_TIMEOUT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $public_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;

        # API responses, especially session and credential-related responses,
        # must never be cached by the static frontend tier.
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    }

    location = /index.html {
        try_files /index.html =404;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
