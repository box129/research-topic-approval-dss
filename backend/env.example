# ============================================
# Server Configuration
# ============================================
PORT=3000
NODE_ENV=development
API_VERSION=v1

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/topic_similarity?schema=public"

# Shadow database URL for Prisma migrations (optional for managed databases)
# If using a managed database service (like Neon, Supabase), you may need this
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/topic_similarity_shadow?schema=public"

# ============================================
# SBERT Service Configuration
# ============================================
# URL of the SBERT (Sentence-BERT) microservice
SBERT_SERVICE_URL=http://localhost:8000

# Timeout for SBERT service requests (in milliseconds)
SBERT_TIMEOUT=30000

# Number of retry attempts for failed SBERT requests
SBERT_RETRY_ATTEMPTS=3

# ============================================
# Rate Limiting Configuration
# ============================================
# Time window for rate limiting (in milliseconds)
# Default: 900000 (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per IP within the time window
RATE_LIMIT_MAX=100

# ============================================
# CORS Configuration
# ============================================
# Frontend URL used for CORS and mock auth email links
# Preferred over CORS_ORIGIN when both are set.
# Required in production unless CORS_ORIGIN is set.
FRONTEND_URL=http://localhost:5173

# Allowed origin for CORS requests when FRONTEND_URL is not set
# For development, typically your frontend URL
# Production must use an explicit trusted origin; "*" is rejected.
CORS_ORIGIN=http://localhost:5173

# Allow credentials in CORS requests (true/false)
CORS_CREDENTIALS=true

# ============================================
# Logging Configuration
# ============================================
# Logging level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log file path (relative to project root)
LOG_FILE=logs/app.log

# ============================================
# Similarity Configuration
# ============================================
# Threshold for Tier 2 similarity (0.0 to 1.0)
# Topics with similarity >= this value are considered Tier 2
SIMILARITY_TIER2_THRESHOLD=0.60

# Time window for Tier 3 similarity check (in hours)
# Topics within this time window are checked for Tier 3 similarity
SIMILARITY_TIER3_TIME_WINDOW_HOURS=48

# ============================================
# Authentication
# ============================================
# Required in production. The development fallback is local-only and unsafe.
# Production rejects short values and known placeholders. Use a generated
# secret with at least 32 random characters and store it outside Git.
JWT_SECRET=replace_with_a_long_random_secret_before_production
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=rtadss_session
RESET_TOKEN_EXPIRES_MINUTES=30

# ============================================
# Email Delivery
# ============================================
# Supported values:
# - mock: local/test only; accepts email requests without external delivery
# - disabled: fail closed; useful when email delivery is intentionally unavailable
# - smtp: validates SMTP configuration, but SMTP transport integration is deferred in this build
# Production must set EMAIL_PROVIDER explicitly. EMAIL_PROVIDER=mock is rejected in production.
# EMAIL_PROVIDER=disabled is fail-closed. EMAIL_PROVIDER=smtp validates settings,
# but real SMTP transport delivery remains deferred in this release candidate.
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@example.edu

# Required only when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# ============================================
# Optional: API Keys and Secrets
# ============================================
# Add any API keys or secrets here as needed
# API_KEY=your_api_key_here
