// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SubmissionStatus {
  PENDING_REVIEW
  AWAITING_REVISION
  APPROVED
  REJECTED
}

model User {
  id                       Int                       @id @default(autoincrement())
  name                     String                    @db.VarChar(200)
  email                    String                    @unique @db.VarChar(200)
  passwordHash             String                    @map("password_hash") @db.Text
  role                     Role
  status                   UserStatus                @default(ACTIVE)
  resetTokenHash           String?                   @map("reset_token_hash") @db.Text
  resetTokenExpiresAt      DateTime?                 @map("reset_token_expires_at")
  studentSubmissions       Submission[]              @relation("StudentSubmissions")
  submissionDecisions      Submission[]              @relation("SubmissionDecisions")
  similarityCheckSnapshots SimilarityCheckSnapshot[]
  updatedSystemSettings    SystemSetting[]           @relation("SystemSettingUpdatedBy")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@map("users")
}

model AcademicSession {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  isCurrent   Boolean      @default(false) @map("is_current")
  submissions Submission[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([isCurrent])
  @@map("academic_sessions")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  updatedById Int?     @map("updated_by_id")
  updatedBy   User?    @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Submission {
  id                       Int                       @id @default(autoincrement())
  studentId                Int                       @map("student_id")
  student                  User                      @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  sessionId                Int?                      @map("session_id")
  session                  AcademicSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  title                    String                    @db.Text
  category                 String?                   @db.Text
  keywords                 String?                   @db.Text
  status                   SubmissionStatus          @default(PENDING_REVIEW)
  decisionReason           String?                   @map("decision_reason") @db.Text
  decidedById              Int?                      @map("decided_by_id")
  decidedBy                User?                     @relation("SubmissionDecisions", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt                DateTime?                 @map("decided_at")
  similarityCheckSnapshots SimilarityCheckSnapshot[]
  submittedAt              DateTime                  @default(now()) @map("submitted_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([sessionId])
  @@index([status])
  @@index([decidedById])
  @@index([submittedAt])
  @@map("submissions")
}

model SimilarityCheckSnapshot {
  id             Int        @id @default(autoincrement())
  submissionId   Int        @map("submission_id")
  submission     Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  checkedById    Int        @map("checked_by_id")
  checkedBy      User       @relation(fields: [checkedById], references: [id], onDelete: Restrict)
  responseStatus String     @map("response_status") @db.VarChar(50)
  overallRisk    String?    @map("overall_risk") @db.VarChar(50)
  maxSimilarity  Float?     @map("max_similarity")
  recommendation String?    @db.Text
  resultSummary  Json?      @map("result_summary")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([submissionId])
  @@index([checkedById])
  @@index([createdAt])
  @@map("similarity_check_snapshots")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  eventType  String   @map("event_type") @db.VarChar(100)
  actorId    Int?     @map("actor_id")
  actorRole  String?  @map("actor_role") @db.VarChar(50)
  actorEmail String?  @map("actor_email") @db.VarChar(200)
  targetType String?  @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(100)
  requestId  String?  @map("request_id") @db.VarChar(100)
  ipAddress  String?  @map("ip_address") @db.VarChar(100)
  userAgent  String?  @map("user_agent") @db.Text
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([actorId])
  @@index([actorRole])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model HistoricalTopic {
  id             Int      @id @default(autoincrement())
  title          String   @db.Text
  keywords       String?  @db.Text
  sessionYear    String   @map("session_year")
  supervisorName String   @map("supervisor_name")
  category       String?
  population     String?  @db.Text
  location       String?  @db.Text
  studyFocus     String?  @map("study_focus") @db.Text
  rawRecord      Json?    @map("raw_record")
  importWarnings Json?    @map("import_warnings")
  sourceType     String?  @map("source_type")
  sourceFilename String?  @map("source_filename") @db.Text
  importBatchId  String?  @map("import_batch_id")
  embedding      Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([sessionYear])
  @@index([createdAt])
  @@index([importBatchId])
  @@map("historical_topics")
}

model CurrentSessionTopic {
  id             Int       @id @default(autoincrement())
  title          String    @db.Text
  keywords       String?   @db.Text
  sessionYear    String    @map("session_year")
  supervisorName String    @map("supervisor_name")
  category       String?
  population     String?   @db.Text
  location       String?   @db.Text
  studyFocus     String?   @map("study_focus") @db.Text
  rawRecord      Json?     @map("raw_record")
  importWarnings Json?     @map("import_warnings")
  sourceType     String?   @map("source_type")
  sourceFilename String?   @map("source_filename") @db.Text
  importBatchId  String?   @map("import_batch_id")
  embedding      Json?
  approvedDate   DateTime? @map("approved_date")
  studentId      String?   @map("student_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([sessionYear])
  @@index([createdAt])
  @@index([importBatchId])
  @@map("current_session_topics")
}

model UnderReviewTopic {
  id                Int       @id @default(autoincrement())
  title             String    @db.Text
  keywords          String?   @db.Text
  sessionYear       String    @map("session_year")
  supervisorName    String    @map("supervisor_name")
  category          String?
  population        String?   @db.Text
  location          String?   @db.Text
  studyFocus        String?   @map("study_focus") @db.Text
  rawRecord         Json?     @map("raw_record")
  importWarnings    Json?     @map("import_warnings")
  sourceType        String?   @map("source_type")
  sourceFilename    String?   @map("source_filename") @db.Text
  importBatchId     String?   @map("import_batch_id")
  embedding         Json?
  reviewStartedAt   DateTime? @map("review_started_at")
  reviewingLecturer String?   @map("reviewing_lecturer")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([sessionYear])
  @@index([createdAt])
  @@index([reviewStartedAt])
  @@index([importBatchId])
  @@map("under_review_topics")
}
